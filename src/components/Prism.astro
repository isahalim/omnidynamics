---
import { PRISM_STATES, type PrismState } from "../lib/glass/models";

interface Props {
  /** Shape shown on load. */
  initial?: PrismState;
  /** The landing page picks a platform; the coming-soon pages are fixed. */
  picker?: boolean;
  /**
   * Pans the camera sideways in world units, sliding the prism the other way
   * across the viewport. The coming-soon pages use it to clear their copy.
   */
  focus?: number;
  /**
   * Dollies the camera back. The canvas is the whole viewport and the FOV is
   * vertical, so this is how a page sets the prism's share of the wall.
   */
  distance?: number;
}

const {
  initial = "orb",
  picker = true,
  focus = 0,
  distance = 1.45,
} = Astro.props;
---

{/*
  The canvas is the page's wall, not a picture hung on it: it covers the whole
  viewport behind the content, so the plaster the shader lights is the same
  plaster the header and the picker sit on. Nothing above it paints a
  background, which is what keeps the seam out.
*/}
<canvas id="prism" class="wall" aria-hidden="true"></canvas>

<section
  class="stage"
  data-initial={initial}
  data-focus={focus}
  data-distance={distance}
>
  {/* Click surface: the shape fills the middle of the viewport. */}
  {picker && (
    <button id="prism-hit" type="button" class="hit">
      <span class="sr-only">Open the selected platform</span>
    </button>
  )}

  <p id="prism-status" class="status" role="status" aria-live="polite"></p>

  {picker && (
    <div class="picker" role="group" aria-label="Platform">
      {PRISM_STATES.map((state) => (
        <button
          type="button"
          class="chip clicky"
          data-state={state.id}
          aria-pressed={state.id === initial ? "true" : "false"}
        >
          {state.label}
        </button>
      ))}
    </div>
  )}

  {picker && <div id="warp" class="warp" hidden></div>}
</section>

<style>
  .wall {
    position: fixed;
    inset: 0;
    /* Behind everything in the page's stacking context — the header and the
       picker are unpositioned, so at z-index 0 the canvas would paint over
       them — but still above the body colour it fades up from. */
    z-index: -1;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    touch-action: none;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  /* Until the GPU wall is up, the body's flat plaster colour stands in. */
  .wall.ready { opacity: 1; }

  .stage {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(1.25rem, 3vh, 2.25rem);
    padding-block-end: clamp(1.5rem, 5vh, 3.5rem);
    min-block-size: clamp(22rem, 60vh, 42rem);
  }

  .hit {
    place-self: center;
    inline-size: min(26rem, 40vw);
    block-size: min(26rem, 52vh);
    border: 0;
    padding: 0;
    background: none;
    border-radius: 50% / 40%;
    cursor: pointer;
  }
  .hit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .status {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .status.on { opacity: 1; }

  .picker {
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.1),
      0 12px 28px -16px rgb(60 48 34 / 0.45);
  }

  .chip {
    min-inline-size: 5.75rem;
    padding: 0.6rem 1.05rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.12s ease,
      box-shadow 0.2s ease;
  }
  .chip:hover { color: var(--ink); background: rgb(255 255 255 / 0.6); }
  .chip[aria-pressed="true"] {
    color: var(--wall);
    background: var(--ink);
    box-shadow: 0 1px 2px rgb(60 48 34 / 0.2), 0 8px 18px -10px rgb(20 18 15 / 0.8);
  }
  .chip[disabled] { opacity: 0.45; cursor: progress; }

  /* Zoom-through: the orb swallows the viewport before navigation. */
  .warp {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: radial-gradient(circle at var(--x, 50%) var(--y, 45%), #07070a 0 22%, transparent 60%);
    opacity: 0;
    transform: scale(0.25);
    transform-origin: var(--x, 50%) var(--y, 45%);
  }
  .warp.go {
    animation: swallow 620ms cubic-bezier(0.7, 0, 0.84, 0) forwards;
  }
  @keyframes swallow {
    from { opacity: 0.2; transform: scale(0.25); }
    to   { opacity: 1;   transform: scale(9); }
  }

  .sr-only {
    position: absolute;
    inline-size: 1px; block-size: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .wall, .status { transition: none; }
    .warp.go { animation-duration: 1ms; }
  }
</style>

<script>
  import { createRenderer } from "../lib/glass/renderer";
  import { PRISM_STATES, prefetchInteriors, type PrismState } from "../lib/glass/models";

  const stage = document.querySelector<HTMLElement>(".stage");
  const canvas = document.getElementById("prism") as HTMLCanvasElement | null;
  const status = document.getElementById("prism-status");
  if (!stage || !canvas || !status) throw new Error("prism markup missing");

  // Only the landing page offers a click-through; the coming-soon pages are
  // already the destination.
  const hit = document.getElementById("prism-hit") as HTMLButtonElement | null;
  const warp = document.getElementById("warp");

  const picker = document.querySelector<HTMLElement>(".picker");
  const chips = picker ? [...picker.querySelectorAll<HTMLButtonElement>(".chip")] : [];
  const hrefFor = new Map(PRISM_STATES.map((s) => [s.id, s.href] as const));

  const say = (message: string) => {
    status.textContent = message;
    status.classList.toggle("on", message !== "");
  };

  if (!("gpu" in navigator)) say("This page needs WebGPU");

  const initial = (stage.dataset.initial ?? "orb") as PrismState;
  const distanceScale = Number(stage.dataset.distance ?? 1) || 1;
  // The pan only makes sense while the copy sits beside the prism. Once the
  // layout stacks, the same offset would push the prism off the screen edge,
  // so it recentres with the breakpoint.
  const focus = Number(stage.dataset.focus ?? 0) || 0;
  const wide = window.matchMedia("(min-width: 56rem)");
  const focusFor = () => (wide.matches ? focus : 0);
  const renderer = createRenderer({
    canvas,
    framing: { focus: focusFor(), distanceScale },
  });
  if (focus !== 0) {
    wide.addEventListener("change", () => renderer.setFocus(focusFor()));
  }
  let current: PrismState = "orb";

  // Nothing can be selected until there is a scene to morph: a click landing
  // before then moved the pressed chip without changing the shape, and left
  // the two out of step for the rest of the session.
  for (const chip of chips) chip.disabled = true;

  renderer.ready.then(
    async () => {
      canvas.classList.add("ready");
      for (const chip of chips) chip.disabled = false;
      if (initial !== "orb") {
        await renderer.setState(initial);
        current = initial;
      }
      if (typeof window.requestIdleCallback === "function") {
        window.requestIdleCallback(prefetchInteriors);
      } else {
        window.setTimeout(prefetchInteriors, 1200);
      }
    },
    // A silent canvas is the worst failure mode, so surface it.
    (error: unknown) => {
      say("The prism could not start");
      console.error("prism renderer failed", error);
    }
  );

  const select = async (next: PrismState, chip: HTMLButtonElement) => {
    if (next === current) return;
    current = next;
    for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));

    const slow = window.setTimeout(() => say("Loading"), 260);
    for (const c of chips) c.disabled = true;
    try {
      await renderer.setState(next);
    } catch (error) {
      console.error("prism state failed", error);
      say("That platform could not load");
      window.setTimeout(() => say(""), 2400);
    } finally {
      window.clearTimeout(slow);
      if (status.textContent === "Loading") say("");
      for (const c of chips) c.disabled = false;
    }
  };

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      void select(chip.dataset.state as PrismState, chip);
    });
  }

  /** The orb zooms through to the product; every other shape opens its page. */
  hit?.addEventListener("click", (event) => {
    event.preventDefault();
    const href = hrefFor.get(current) ?? `/soon/${current}/`;
    if (current !== "orb") {
      window.location.href = href;
      return;
    }
    if (!warp) { window.location.href = href; return; }
    const box = hit.getBoundingClientRect();
    warp.style.setProperty("--x", `${((box.left + box.width / 2) / window.innerWidth) * 100}%`);
    warp.style.setProperty("--y", `${((box.top + box.height / 2) / window.innerHeight) * 100}%`);
    warp.hidden = false;
    warp.classList.add("go");
    const go = () => { window.location.href = href; };
    warp.addEventListener("animationend", go, { once: true });
    window.setTimeout(go, 900); // guard if the animation never fires
  });

  window.addEventListener("pagehide", () => renderer.dispose(), { once: true });
</script>
