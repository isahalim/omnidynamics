---
import { PRISM_STATES } from "../lib/glass/models";

/** The page opens on the orb, so its copy is the copy that ships in the HTML. */
const opening = PRISM_STATES[0]!;
---

{/*
  The canvas is the page's wall, not a picture hung on it: it covers the whole
  viewport behind the content, so the plaster the shader lights is the same
  plaster the header and the picker sit on. Nothing above it paints a
  background, which is what keeps the seam out.
*/}
<canvas id="prism" class="wall" aria-hidden="true"></canvas>

<section class="stage">
  {/*
    Click surface, and the box the glass is fitted into: the renderer measures
    it and dollies the camera until the pyramid fills it, so the shape and the
    thing you click on are the same rectangle.
  */}
  <button id="prism-hit" type="button" class="hit">
    <span class="sr-only">Open the selected platform</span>
  </button>

  <p id="prism-status" class="status" role="status" aria-live="polite"></p>

  {/*
    What is in the glass, beside it. The shipped tool says what it is; the rest
    say what a click on them does. It sits in the gutter to the left of the
    pyramid on a wide screen — the shape fills the frame by its height, so that
    gutter is bare plaster — and drops under the shape on a narrow one.
  */}
  <div class="about" id="prism-about">
    <p class="blurb" id="prism-blurb">{opening.blurb}</p>
    <p class="hint" id="prism-hint">{opening.hint}</p>
  </div>

  <div class="picker" role="group" aria-label="Platform">
    {PRISM_STATES.map((state) => (
      <button
        type="button"
        class="chip clicky"
        data-state={state.id}
        aria-pressed={state.id === "orb" ? "true" : "false"}
      >
        {state.label}
      </button>
    ))}
  </div>
</section>

<style>
  .wall {
    position: fixed;
    inset: 0;
    /* Behind everything in the page's stacking context — the header and the
       picker are unpositioned, so at z-index 0 the canvas would paint over
       them — but still above the body colour it fades up from. */
    z-index: -1;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    touch-action: none;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  /* Until the GPU wall is up, the body's flat plaster colour stands in. */
  .wall.ready { opacity: 1; }

  .stage {
    position: relative;
    z-index: 2;
    flex: 1;
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: clamp(0.75rem, 2vh, 1.5rem);
    padding-block-end: clamp(1.25rem, 4vh, 3rem);
    min-block-size: clamp(22rem, 66vh, 46rem);
  }

  /* The box the glass is fitted into: the renderer dollies the camera until the
     pyramid fills this rectangle, so this is the shape's size on the page, and
     the wall's shadow, contact bake and caustic pool come with it. It is sized
     to take the frame — everything but the header and the picker — rather than
     to sit politely in the middle of it. */
  .hit {
    grid-row: 1;
    place-self: center;
    /* A finger turns the shape, so a drag across it must not be read as a
       scroll. Only the shape's own box takes the gesture — on a small phone the
       page may still need to scroll, and pinch is left alone everywhere. */
    touch-action: pinch-zoom;
    inline-size: min(54rem, 68vw);
    block-size: min(54rem, 70vh);
    border: 0;
    padding: 0;
    background: none;
    border-radius: 50% / 40%;
    cursor: pointer;
  }

  /* A phone has no width to spare, and the platform inside the glass is the
     whole point of the page — so the pyramid takes the screen. */
  @media (max-width: 48rem) {
    .hit {
      inline-size: 90vw;
      block-size: min(90vw, 52vh);
    }
  }
  .hit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .status {
    position: absolute;
    inset-block-start: 0.5rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .status.on { opacity: 1; }

  .about {
    grid-row: 2;
    justify-self: center;
    max-inline-size: 32rem;
    margin: 0;
    text-align: center;
    transition: opacity 0.24s ease;
  }
  .about.changing { opacity: 0; }

  .blurb {
    margin: 0;
    font-size: clamp(1rem, 1.35vw, 1.1rem);
    line-height: 1.45;
    color: var(--ink);
  }
  .blurb:empty { display: none; }

  .hint {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Wide enough for a gutter: the copy moves out beside the glass, and the
     shape takes the whole height of the frame again. The row it is pinned to is
     the shape's own, because an absolutely positioned grid child is placed
     against its grid area rather than against the grid — pinned to its old row
     it would centre itself on a row of no height. */
  @media (min-width: 60rem) {
    .about {
      grid-row: 1;
      position: absolute;
      inset-block-start: 50%;
      inset-inline-start: 0;
      translate: 0 -50%;
      inline-size: min(19rem, 24vw);
      max-inline-size: none;
      text-align: start;
    }
  }

  .picker {
    grid-row: 3;
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.1),
      0 12px 28px -16px rgb(60 48 34 / 0.45);
  }

  .chip {
    min-inline-size: 5rem;
    padding: 0.6rem 1.05rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.12s ease,
      box-shadow 0.2s ease;
  }
  .chip:hover { color: var(--ink); background: rgb(255 255 255 / 0.6); }
  .chip[aria-pressed="true"] {
    color: var(--wall);
    background: var(--ink);
    box-shadow: 0 1px 2px rgb(60 48 34 / 0.2), 0 8px 18px -10px rgb(20 18 15 / 0.8);
  }
  .chip[disabled] { opacity: 0.45; cursor: progress; }

  .sr-only {
    position: absolute;
    inline-size: 1px; block-size: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .wall, .status, .about { transition: none; }
  }
</style>

<script>
  import { createHeroRenderer } from "../lib/prism/hero-renderer";
  import type { PrismInteriorId } from "../lib/prism/interior";
  import {
    PRISM_STATES,
    interiorFor,
    prefetchInteriors,
    type PrismState,
  } from "../lib/glass/models";
  import { withBase } from "../lib/base";

  const canvas = document.getElementById("prism") as HTMLCanvasElement | null;
  const status = document.getElementById("prism-status");
  const hit = document.getElementById("prism-hit") as HTMLButtonElement | null;
  const about = document.getElementById("prism-about");
  const blurb = document.getElementById("prism-blurb");
  const hint = document.getElementById("prism-hint");
  const picker = document.querySelector<HTMLElement>(".picker");
  if (!canvas || !status || !hit || !about || !blurb || !hint || !picker) {
    throw new Error("prism markup missing");
  }

  const chips = [...picker.querySelectorAll<HTMLButtonElement>(".chip")];
  const infoFor = new Map(PRISM_STATES.map((s) => [s.id, s] as const));

  const say = (message: string) => {
    status.textContent = message;
    status.classList.toggle("on", message !== "");
  };

  if (!("gpu" in navigator)) say("This page needs WebGPU");

  // The coming-soon pages' wall, with vgpu's glass-fractal tetrahedron standing
  // on it and a platform held inside the glass.
  const renderer = createHeroRenderer({ canvas, frame: hit });
  let current: PrismState = "orb";

  // Nothing can be selected until there is a scene to morph: a click landing
  // before then moved the pressed chip without changing the shape, and left
  // the two out of step for the rest of the session.
  for (const chip of chips) chip.disabled = true;

  renderer.ready.then(
    () => {
      canvas.classList.add("ready");
      for (const chip of chips) chip.disabled = false;
      if (typeof window.requestIdleCallback === "function") {
        window.requestIdleCallback(prefetchInteriors);
      } else {
        window.setTimeout(prefetchInteriors, 1200);
      }
    },
    // A silent canvas is the worst failure mode, so surface it.
    (error: unknown) => {
      say("The prism could not start");
      console.error("prism renderer failed", error);
    }
  );

  /** Swaps the copy beside the glass, fading through so it does not jump. */
  const describe = (state: PrismState) => {
    const info = infoFor.get(state);
    if (!info) return;
    about.classList.add("changing");
    window.setTimeout(() => {
      blurb.textContent = info.blurb ?? "";
      hint.textContent = info.hint;
      about.classList.remove("changing");
    }, 200);
  };

  const select = async (next: PrismState, chip: HTMLButtonElement) => {
    if (next === current) return;
    current = next;
    for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));
    describe(next);

    const slow = window.setTimeout(() => say("Loading"), 260);
    for (const c of chips) c.disabled = true;
    try {
      await renderer.setState(interiorFor(next) as PrismInteriorId);
    } catch (error) {
      console.error("prism state failed", error);
      say("That platform could not load");
      window.setTimeout(() => say(""), 2400);
    } finally {
      window.clearTimeout(slow);
      if (status.textContent === "Loading") say("");
      for (const c of chips) c.disabled = false;
    }
  };

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      void select(chip.dataset.state as PrismState, chip);
    });
  }

  /**
   * A click on the shape opens it. A finger dragging the shape around also ends
   * in a click, so a pointer that travelled more than a few pixels is a turn
   * rather than a tap and is not followed.
   */
  const TAP_SLOP = 10;
  let pressedAt: { x: number; y: number } | undefined;

  hit.addEventListener("pointerdown", (event) => {
    pressedAt = { x: event.clientX, y: event.clientY };
  });

  hit.addEventListener("click", (event) => {
    event.preventDefault();
    const travelled = pressedAt
      ? Math.hypot(event.clientX - pressedAt.x, event.clientY - pressedAt.y)
      : 0;
    pressedAt = undefined;
    if (travelled > TAP_SLOP) return;
    window.location.href = infoFor.get(current)?.href ?? withBase(`/soon/${current}/`);
  });

  /**
   * Back-navigation restores this page from the browser's cache without running
   * the script again, so a renderer torn down on the way out would leave a dead
   * canvas — a bare wall with a working picker over it. Nothing is disposed
   * when the page is only being put aside; it is woken instead, and disposed
   * for real only when the page is actually going away.
   */
  window.addEventListener("pagehide", (event) => {
    if (!event.persisted) renderer.dispose();
  });
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) renderer.resume();
  });
</script>
