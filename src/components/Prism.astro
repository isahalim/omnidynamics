---
import { PRISM_STATES } from "../lib/glass/models";
---

<section class="stage">
  <div class="frame">
    <canvas id="prism" aria-label="Interactive glass prism containing the selected platform"></canvas>

    <!-- Click surface: the shape fills the middle of the frame. -->
    <button id="prism-hit" type="button" class="hit" aria-describedby="prism-hint">
      <span class="sr-only">Open the selected platform</span>
    </button>

    <p id="prism-status" class="status" role="status" aria-live="polite"></p>

    <div id="soon" class="soon" hidden>
      <span class="soon-prism" aria-hidden="true"></span>
      <span class="soon-text">Coming soon</span>
    </div>
  </div>

  <div class="picker" role="group" aria-label="Platform">
    {PRISM_STATES.map((state) => (
      <button
        type="button"
        class="chip clicky"
        data-state={state.id}
        aria-pressed={state.id === "orb" ? "true" : "false"}
      >
        {state.label}
      </button>
    ))}
  </div>

  <div id="warp" class="warp" hidden></div>
</section>

<style>
  .stage {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 3vh, 2.25rem);
    padding-block-end: clamp(2rem, 6vh, 4rem);
  }

  /* The prism is the page's centrepiece: as tall as the viewport allows. */
  .frame {
    position: relative;
    inline-size: 100%;
    block-size: clamp(24rem, 68vh, 46rem);
    border-radius: 1.5rem;
    overflow: hidden;
  }

  canvas {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    touch-action: none;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  canvas.ready { opacity: 1; }

  .hit {
    position: absolute;
    inset-block: 12%;
    inset-inline: 50%;
    inline-size: min(30rem, 46%);
    translate: -50% 0;
    border: 0;
    padding: 0;
    background: none;
    border-radius: 50% / 40%;
    cursor: pointer;
  }
  .hit:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }

  .status {
    position: absolute;
    inset-block-start: 1.25rem;
    inset-inline-start: 50%;
    translate: -50% 0;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .status.on { opacity: 1; }

  /* "Coming soon" reuses the prism silhouette rather than a generic toast. */
  .soon {
    position: absolute;
    inset-block-end: 8%;
    inset-inline-start: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem 0.6rem 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    letter-spacing: 0.01em;
    color: var(--ink);
    background: rgb(255 255 255 / 0.62);
    backdrop-filter: blur(12px) saturate(170%);
    -webkit-backdrop-filter: blur(12px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.12),
      0 10px 26px -12px rgb(60 48 34 / 0.42);
    animation: rise 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .soon-prism {
    inline-size: 1.1rem;
    block-size: 1.1rem;
    clip-path: polygon(50% 4%, 96% 92%, 4% 92%);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.95), rgb(180 172 160 / 0.75));
    box-shadow: 0 1px 3px rgb(60 48 34 / 0.3);
  }
  @keyframes rise {
    from { opacity: 0; translate: -50% 10px; }
    to   { opacity: 1; translate: -50% 0; }
  }

  .picker {
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.3rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.1),
      0 12px 28px -16px rgb(60 48 34 / 0.45);
  }

  .chip {
    min-inline-size: 5.75rem;
    padding: 0.6rem 1.05rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.12s ease,
      box-shadow 0.2s ease;
  }
  .chip:hover { color: var(--ink); background: rgb(255 255 255 / 0.6); }
  .chip[aria-pressed="true"] {
    color: var(--wall);
    background: var(--ink);
    box-shadow: 0 1px 2px rgb(60 48 34 / 0.2), 0 8px 18px -10px rgb(20 18 15 / 0.8);
  }
  .chip[disabled] { opacity: 0.45; cursor: progress; }

  /* Zoom-through: the orb swallows the viewport before navigation. */
  .warp {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    background: radial-gradient(circle at var(--x, 50%) var(--y, 45%), #07070a 0 22%, transparent 60%);
    opacity: 0;
    transform: scale(0.25);
    transform-origin: var(--x, 50%) var(--y, 45%);
  }
  .warp.go {
    animation: swallow 620ms cubic-bezier(0.7, 0, 0.84, 0) forwards;
  }
  @keyframes swallow {
    from { opacity: 0.2; transform: scale(0.25); }
    to   { opacity: 1;   transform: scale(9); }
  }

  .sr-only {
    position: absolute;
    inline-size: 1px; block-size: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    canvas, .status { transition: none; }
    .soon { animation: none; }
    .warp.go { animation-duration: 1ms; }
  }
</style>

<script>
  import { createRenderer } from "../lib/glass/renderer";
  import { PRISM_STATES, prefetchInteriors, type PrismState } from "../lib/glass/models";

  const canvas = document.getElementById("prism") as HTMLCanvasElement | null;
  const picker = document.querySelector<HTMLElement>(".picker");
  const hit = document.getElementById("prism-hit") as HTMLButtonElement | null;
  const soon = document.getElementById("soon");
  const warp = document.getElementById("warp");
  const status = document.getElementById("prism-status");
  if (!canvas || !picker || !hit || !soon || !warp || !status) throw new Error("prism markup missing");

  const hrefFor = new Map(PRISM_STATES.map((s) => [s.id, s.href] as const));
  const chips = [...picker.querySelectorAll<HTMLButtonElement>(".chip")];

  if (!("gpu" in navigator)) {
    status.textContent = "WebGPU required";
    status.classList.add("on");
  }

  const renderer = createRenderer({ canvas });
  let current: PrismState = "orb";
  let soonTimer = 0;

  void renderer.ready.then(() => {
    canvas.classList.add("ready");
    // Warm the model meshes once the prism is on screen and idle. Accessed off
    // window because requestIdleCallback is absent on older Safari.
    if (typeof window.requestIdleCallback === "function") {
      window.requestIdleCallback(prefetchInteriors);
    } else {
      window.setTimeout(prefetchInteriors, 1200);
    }
  });

  const select = async (next: PrismState, chip: HTMLButtonElement) => {
    if (next === current) return;
    current = next;
    for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));
    soon.hidden = true;

    // The mesh may still be downloading; say so rather than appearing frozen.
    const slow = window.setTimeout(() => {
      status.textContent = "Loading";
      status.classList.add("on");
    }, 260);
    for (const c of chips) c.disabled = true;
    try {
      await renderer.setState(next);
    } finally {
      window.clearTimeout(slow);
      status.classList.remove("on");
      for (const c of chips) c.disabled = false;
    }
  };

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      void select(chip.dataset.state as PrismState, chip);
    });
  }

  hit.addEventListener("click", (event) => {
    const href = hrefFor.get(current) ?? null;
    if (!href) {
      window.clearTimeout(soonTimer);
      soon.hidden = false;
      soonTimer = window.setTimeout(() => { soon.hidden = true; }, 2600);
      return;
    }
    const box = hit.getBoundingClientRect();
    warp.style.setProperty("--x", `${((box.left + box.width / 2) / window.innerWidth) * 100}%`);
    warp.style.setProperty("--y", `${((box.top + box.height / 2) / window.innerHeight) * 100}%`);
    warp.hidden = false;
    warp.classList.add("go");
    const go = () => { window.location.href = href; };
    warp.addEventListener("animationend", go, { once: true });
    window.setTimeout(go, 900); // guard if the animation never fires
    event.preventDefault();
  });

  window.addEventListener("pagehide", () => renderer.dispose(), { once: true });
</script>
