---
/**
 * The monogram, traced from the drawn mark: a ring with a straight stem set a
 * third of the way across it, meeting the ring top and bottom. The ring's own
 * right side is the D's bowl — there is no second arc — which is what keeps it
 * to two strokes and lets it hold at favicon size.
 *
 * It takes `currentColor`, so it is the same ink as the wordmark beside it on
 * whichever wall it sits.
 */
interface Props {
  size?: number;
}
const { size = 42 } = Astro.props;

/** Radius of the ring's centreline, and the stem's offset from centre. */
const RADIUS = 45;
const STEM_X = 28.4;
/** Where the stem meets the ring, so the two strokes join rather than cross. */
const STEM_Y = Math.sqrt(RADIUS ** 2 - (50 - STEM_X) ** 2);
---

<svg
  class="mark"
  style={`--size:${size}px`}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width="9.5"
  stroke-linecap="round"
  role="img"
  aria-label="OmniDynamics"
>
  <circle cx="50" cy="50" r={RADIUS} />
  <line x1={STEM_X} y1={50 - STEM_Y} x2={STEM_X} y2={50 + STEM_Y} />
</svg>

<style>
  .mark {
    display: block;
    inline-size: var(--size);
    block-size: var(--size);
    overflow: visible;
  }
</style>
