---
interface Props {
  size?: number;
}
const { size = 38 } = Astro.props;
---

<span class="mark" style={`--size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 100 100" role="presentation">
    <circle cx="50" cy="50" r="45" fill="none" stroke="currentColor" stroke-width="6" />
    <path
      d="M30 20.5 A38 38 0 1 1 30 79.5 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="6"
      stroke-linejoin="round"
    />
  </svg>
  <span class="sheen"></span>
</span>

<style>
  /* A liquid-glass chip: refracting body, specular sheen, contact shadow. */
  .mark {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: var(--size);
    block-size: var(--size);
    border-radius: 50%;
    color: var(--accent);
    background:
      linear-gradient(150deg, rgb(255 255 255 / 0.75), rgb(255 255 255 / 0.15) 42%, rgb(255 255 255 / 0.5)),
      rgb(255 255 255 / 0.22);
    backdrop-filter: blur(7px) saturate(180%);
    -webkit-backdrop-filter: blur(7px) saturate(180%);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.95),
      inset 0 -1px 2px rgb(120 100 80 / 0.28),
      inset 2px 0 3px -2px rgb(255 255 255 / 0.8),
      0 1px 2px rgb(60 48 34 / 0.14),
      0 6px 16px -6px rgb(60 48 34 / 0.3);
  }

  .mark svg {
    inline-size: 62%;
    block-size: 62%;
    overflow: visible;
    filter: drop-shadow(0 1px 0 rgb(255 255 255 / 0.7));
  }

  /* Moving highlight that sells the wet-glass surface. */
  .sheen {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 30%,
      rgb(255 255 255 / 0.65) 46%,
      transparent 60%
    );
    opacity: 0.75;
    transform: translateX(-14%);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.brand:hover) .sheen {
    transform: translateX(14%);
  }

  @media (prefers-reduced-motion: reduce) {
    .sheen { transition: none; }
  }
</style>
