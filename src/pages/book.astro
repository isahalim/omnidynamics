---
/**
 * Book a demo — where "Contact" used to be.
 *
 * A mail address asks a person to compose something and then wait, which is a
 * strange thing to ask of someone who has already decided they want to see the
 * thing. A calendar asks them to pick a time. Cal.com holds the calendar, the
 * availability, the invitation and the room: the call is held on Cal Video, the
 * event type's own location, so the link on the invitation is Cal's and nothing
 * here arranges it. The address is still on the page, because a calendar is not
 * the right shape for every message.
 *
 * The composition is the contact page's: copy in a measured column with the
 * prism fitted beside it, and the calendar on the same frosted glass every
 * other surface on the site is cut from.
 */
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import LightPrism from "../components/LightPrism.astro";
import { CAL_READY, EMAIL, SIGN_IN_READY, ROUTES } from "../lib/auth/config";
import { withBase } from "../lib/base";
---

<Base
  title="Book a demo — OmniDynamics"
  description="Book a demo of OmniDynamics — drones, manipulators and humanoids."
>
  <LightPrism frame="#prism-stage" />

  <div class="page">
    <header class="top">
      <a class="brand clicky" href={withBase("/")}>
        <Logo size={30} />
        <span class="wordmark">OmniDynamics</span>
      </a>
      <nav class="links">
        <a class="clicky" href={withBase("/")}>Tools</a>
        {SIGN_IN_READY && <a class="clicky" href={ROUTES.signIn}>Sign in</a>}
      </nav>
    </header>

    <main class="split">
      <div class="copy">
        <h1>Book a demo</h1>
        <p class="lede">
          Thirty minutes with the<br />people building it.
        </p>

        <div class="rule" aria-hidden="true"></div>

        <p class="note">
          Pick a time and the invitation arrives with a Cal Video link on it —
          it opens in the browser, with nothing to install and no account to
          make. Bring what you are trying to build: early access, a partnership,
          or a question about a platform, it is the same half hour.
        </p>

        <p class="address">
          Or write to <a class="clicky" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>

        {/* Measured, never painted: the box the prism is fitted into. */}
        <div class="stage" id="prism-stage" aria-hidden="true"></div>
      </div>

      <div class="booking">
        {CAL_READY ? (
          <div class="card">
            <p class="loading" data-loading>Loading the calendar…</p>
            {/* Cal fills this and sizes it from the inside. */}
            <div class="cal" data-cal></div>
            <div class="fallback" data-fallback hidden>
              <p>
                The calendar could not load — a blocked script, or Cal.com is
                having a moment. Write to
                {" "}<a href={`mailto:${EMAIL}`}>{EMAIL}</a> and we will find a
                time by hand.
              </p>
            </div>
          </div>
        ) : (
          <div class="card unwired">
            <p>
              No calendar is connected in this build. Set
              <code>PUBLIC_CAL_LINK</code> to a Cal.com event type — hosted or
              self-hosted, it is AGPL — and this page becomes the booking form.
              A new event type is on Cal Video already, so there is no meeting
              provider to connect.
            </p>
            <p>
              Until then: <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            </p>
          </div>
        )}
      </div>
    </main>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 4vw, 3.5rem)
      clamp(1.5rem, 4vh, 3rem);
    color: var(--on-wall);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }
  .wordmark { font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; }
  .links { display: flex; gap: clamp(1rem, 2.5vw, 2rem); font-size: 0.9375rem; }
  .links a { color: inherit; text-decoration: none; opacity: 0.62; transition: opacity 0.2s ease; }
  .links a:hover { opacity: 1; }

  /* Both columns start at the top, and nothing here may depend on how tall the
     other one is. The calendar arrives late and arrives *long* — Cal sizes its
     own sheet from the inside, and the row grows to fit it — so a centred
     alignment would take the heading that was sitting under the wordmark and
     slide it half a screen down the moment the embed rendered. Anchored to the
     start, the copy is where it was before the calendar existed and stays
     there. */
  .split {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: start;
    gap: clamp(1rem, 4vw, 3rem);
    padding-block-start: clamp(1.5rem, 5vh, 3rem);
  }

  .copy {
    display: flex;
    flex-direction: column;
    max-inline-size: 32rem;
    padding-inline-start: clamp(0rem, 2vw, 1.5rem);
  }

  h1 {
    margin: 0;
    font-family: ui-serif, Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: clamp(0.9rem, 2.5vh, 1.5rem) 0 0;
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.2;
    font-weight: 300;
    letter-spacing: -0.015em;
  }

  .rule {
    inline-size: min(100%, 18rem);
    block-size: 1px;
    margin-block: clamp(1.1rem, 3vh, 1.75rem);
    background: currentColor;
    opacity: 0.28;
  }

  .note {
    margin: 0;
    max-inline-size: 26rem;
    font-size: 1rem;
    line-height: 1.55;
    opacity: 0.68;
  }

  .address {
    margin: clamp(0.9rem, 2.5vh, 1.4rem) 0 0;
    font-size: 0.9375rem;
    opacity: 0.68;
    overflow-wrap: anywhere;
  }
  .address a { color: var(--ink); text-underline-offset: 0.25em; }

  /* The glass sits under the copy and keeps its own height, rather than
     stretching to whatever the calendar beside it happens to be: the prism is
     measured into this box, and a box the height of a month of availability
     would draw a tall thin sliver of one.

     A finger aims the beam by dragging where the prism is drawn, so that box
     must not read the drag as a scroll. */
  .stage {
    block-size: clamp(16rem, 34vh, 26rem);
    margin-block-start: clamp(1rem, 3vh, 2rem);
    touch-action: pinch-zoom;
  }

  .card {
    padding: 0.6rem;
    border-radius: 1.4rem;
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(18px) saturate(170%);
    -webkit-backdrop-filter: blur(18px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.1),
      0 30px 60px -34px rgb(60 48 34 / 0.6);
  }

  .loading {
    margin: 0;
    padding: 4rem 1rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--muted);
  }

  /* Cal draws an opaque sheet of its own inside this, so it is given the card's
     inner radius and told to clip — otherwise its corners sit square on the
     glass. */
  .cal {
    border-radius: 1rem;
    overflow: hidden;
    min-block-size: 0;
  }

  .fallback, .unwired { padding: 1.25rem 1.35rem; font-size: 0.9375rem; line-height: 1.6; }
  .fallback p, .unwired p { margin: 0 0 0.75rem; }
  .unwired p:last-child, .fallback p:last-child { margin-block-end: 0; }
  .unwired code {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 0.35em;
    background: rgb(60 48 34 / 0.08);
  }
  .fallback a, .unwired a { color: inherit; }

  @media (max-width: 62rem) {
    .split {
      grid-template-columns: 1fr;
      align-content: start;
      gap: clamp(1.5rem, 5vh, 2.5rem);
    }
    .copy { padding-inline-start: 0; max-inline-size: none; }
    .stage { display: none; }
  }
</style>

<script>
  import { CAL_READY, SIGN_IN_READY } from "../lib/auth/config";
  import { mountBooking } from "../lib/booking";

  if (CAL_READY) {
    const target = document.querySelector<HTMLElement>("[data-cal]");
    const loading = document.querySelector<HTMLElement>("[data-loading]");
    const fallback = document.querySelector<HTMLElement>("[data-fallback]");
    if (!target || !loading || !fallback) throw new Error("booking markup missing");

    // If this tab is signed in, the name and address are already known and
    // there is no reason to make someone type them again. Nobody waits on that
    // though: checking the token means fetching Google's signing keys, and a
    // signed-out reader must not sit in front of an empty card while that
    // happens — and on a build with no sign-in at all, none of it is fetched.
    const known = !SIGN_IN_READY
      ? Promise.resolve(null)
      : import("../lib/auth/session").then((session) =>
          Promise.race([
            session.restore().catch(() => null),
            new Promise((resolve) => window.setTimeout(resolve, 1500)),
          ]).then(() => session.current())
        );

    known
      .then((who) => mountBooking(target, { name: who?.name, email: who?.email }))
      .then(() => { loading.hidden = true; })
      .catch((error: unknown) => {
        console.error("cal.com embed failed", error);
        loading.hidden = true;
        fallback.hidden = false;
      });
  }
</script>
