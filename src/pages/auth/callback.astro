---
/**
 * Where the provider sends a person back to.
 *
 * Deliberately the plainest page on the site: no canvas, no fonts to wait for,
 * nothing to look at. It exists for the two or three hundred milliseconds it
 * takes to check `state`, trade the code and its verifier for tokens, and
 * validate the id token — and then it is gone. The only thing worth designing
 * here is what happens when that fails, because a redirect that lands on a
 * blank page is indistinguishable from a site that is broken.
 */
import Base from "../../layouts/Base.astro";
import { ROUTES } from "../../lib/auth/config";
---

<Base title="Signing in — OmniDynamics" description="Completing sign-in.">
  <main>
    <p class="working" data-working>Signing you in…</p>

    <div class="failed" data-failed hidden>
      <h1>That sign-in did not complete</h1>
      <p class="why" data-why></p>
      <p class="links">
        <a class="clicky" href={ROUTES.signIn}>Try again</a>
        <a class="clicky" href={ROUTES.home}>Back to the site</a>
      </p>
    </div>
  </main>
</Base>

<style>
  main {
    min-block-size: 100dvh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.75rem;
    max-inline-size: 34rem;
    margin-inline: auto;
    padding: 2rem 1.5rem;
    color: var(--on-wall);
  }

  .working { margin: 0; font-size: 1rem; color: var(--muted); }

  h1 {
    margin: 0 0 0.5rem;
    font-family: ui-serif, Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .why { margin: 0; font-size: 1rem; line-height: 1.55; color: var(--muted); }

  .links { display: flex; gap: 1.25rem; margin: 1.25rem 0 0; font-size: 0.9375rem; }
  .links a { color: inherit; text-underline-offset: 0.25em; }
</style>

<script>
  import { completeSignIn } from "../../lib/auth/session";
  import { ROUTES } from "../../lib/auth/config";

  const working = document.querySelector<HTMLElement>("[data-working]");
  const failed = document.querySelector<HTMLElement>("[data-failed]");
  const why = document.querySelector<HTMLElement>("[data-why]");
  if (!working || !failed || !why) throw new Error("callback markup missing");

  const show = (message: string) => {
    working.hidden = true;
    failed.hidden = false;
    why.textContent = message;
  };

  const query = new URLSearchParams(window.location.search);
  const refused = query.get("error");

  if (refused) {
    // The provider turned it down before any code was issued — someone pressed
    // cancel, or the client is not allowed to ask for what it asked for.
    show(
      refused === "access_denied"
        ? "The sign-in was cancelled."
        : query.get("error_description") || `The provider reported “${refused}”.`
    );
  } else if (!query.has("code")) {
    // Nothing here is a destination. A person who lands on it from history,
    // with no code to trade, belongs on the sign-in page.
    window.location.replace(ROUTES.signIn);
  } else {
    completeSignIn().then(
      (next) => window.location.replace(next),
      (error: unknown) => {
        console.error("sign-in callback failed", error);
        // A mismatched `state`, an expired or replayed code, an id token that
        // did not validate. None of them are worth explaining to a reader, and
        // all of them are fixed the same way.
        show("The link may have expired, or it was already used. Signing in again will fix it.");
      }
    );
  }
</script>
