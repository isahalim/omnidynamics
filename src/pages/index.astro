---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Prism from "../components/Prism.astro";
import AccountActions from "../components/AccountActions.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/base";
---

<Base
  title="OmniDynamics"
  description="OmniDynamics deploys scalable agentic systems and platforms for evaluating Physical AI Agents."
>
  <div class="page">
    <!-- Not a bar: the header sits directly on the wall with the prism. It is
         pinned all the same, because the page under it scrolls now — and
         nothing ever passes behind it, since the stage is pinned too. -->
    <header class="top" id="top">
      <a class="brand clicky" href={withBase("/")}>
        <Logo />
        <span class="wordmark">OmniDynamics</span>
      </a>

      {/* The policy used to sit beside the rail as plain text. It is in the
          floor now, with everything else a reader looks for at the end of a
          page, which leaves the header as the way in and nothing else. */}
      <nav class="right">
        <AccountActions />
      </nav>
    </header>

    <main>
      <Prism />
    </main>
  </div>

  {/* Outside the shell, because it is full-bleed and the shell is a measured
      column. The runway inside the shell is built a floor's height longer and
      then gives that height back, so the grey rises over scroll the dial has
      finished with and the shell ends on the floor's own top edge — see
      `--floor-block` in the component and `.reel.reeling` in the prism. */}
  <Footer />
</Base>

<style>
  /* A column over the wall: header at the top, the prism stage taking the rest
     so the picker settles just above the bottom edge. The height is the stage's
     own business — without the script it is one viewport, with it two. */
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    max-inline-size: 88rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  /* The header carries its own vertical padding rather than taking it from the
     page, so that what it occupies is one measurable band — which is what the
     stage below sticks underneath. */
  .top {
    position: sticky;
    inset-block-start: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1rem, 2.5vw, 1.75rem) clamp(0.75rem, 2vh, 1.5rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }

  .wordmark {
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  /* One pill group, carrying the whole of the way in. */
  .right {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }
</style>

<script>
  /**
   * How tall the header's band is, published as `--top-band`.
   *
   * The stage sticks directly underneath it and is sized to what is left of the
   * viewport, and both of those are the header's height — which is a clamp on
   * the viewport, a mark at one of two sizes, and a pill rail whose contents
   * depend on whether anyone is signed in. Measuring it is the only honest
   * answer; guessing it puts the glass behind the brand on one phone and leaves
   * a gap on the next.
   */
  const top = document.getElementById("top");
  if (top) {
    const publish = () =>
      document.documentElement.style.setProperty(
        "--top-band",
        `${Math.round(top.getBoundingClientRect().height)}px`
      );
    new ResizeObserver(publish).observe(top);
    publish();
  }
</script>
