---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Prism from "../components/Prism.astro";
import AccountActions from "../components/AccountActions.astro";
import { ROUTES } from "../lib/auth/config";
import { withBase } from "../lib/base";
---

<Base
  title="OmniDynamics"
  description="OmniDynamics builds embodied intelligence — drones, manipulators and humanoids."
>
  <div class="page">
    <!-- Not a bar: the header sits directly on the wall with the prism. -->
    <header class="top">
      <a class="brand clicky" href={withBase("/")}>
        <Logo />
        <span class="wordmark">OmniDynamics</span>
      </a>

      <nav class="right">
        <a class="quiet" href={ROUTES.privacy}>Privacy</a>
        <AccountActions />
      </nav>
    </header>

    <main>
      <Prism />
    </main>
  </div>
</Base>

<style>
  /* A viewport-tall column over the wall: header at the top, the prism stage
     taking the rest so the picker settles just above the bottom edge. */
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    max-inline-size: 88rem;
    margin-inline: auto;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1rem, 4vw, 3rem) 0;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: clamp(0.75rem, 2vh, 1.5rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }

  .wordmark {
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  /* The pill group carries the weight; the policy sits beside it as plain
     text, always reachable and never competing with the way in. */
  .right {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.5rem);
  }

  .quiet {
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .quiet:hover { color: var(--ink); }

  @media (max-width: 30rem) {
    .quiet { display: none; }
  }
</style>
