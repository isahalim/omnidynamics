---
import Base from '../layouts/Base.astro';
---

<Base title="Omnidynamics" description="Omnidynamics — coming soon.">
  <main>
    <p class="eyebrow">Omnidynamics</p>
    <h1>Placeholder</h1>
    <p class="lede">
      The pipeline is live. This page exists so the deploy has something to
      serve — the real hero lands next.
    </p>
  </main>

  <style>
    main {
      min-height: 100dvh;
      display: grid;
      align-content: center;
      gap: 0.75rem;
      max-width: 40rem;
      margin-inline: auto;
      padding: 2rem 1.5rem;
    }

    .eyebrow {
      margin: 0;
      font-size: 0.8125rem;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
    }

    h1 {
      margin: 0;
      font-size: clamp(2.5rem, 8vw, 4rem);
      line-height: 1.05;
      letter-spacing: -0.03em;
      font-weight: 600;
    }

    .lede {
      margin: 0;
      max-width: 32rem;
      font-size: 1.0625rem;
      color: var(--muted);
    }
  </style>
</Base>
