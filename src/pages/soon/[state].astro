---
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import LightPrism from "../../components/LightPrism.astro";
import { PRISM_STATES } from "../../lib/glass/models";

export function getStaticPaths() {
  return PRISM_STATES.filter((state) => state.href === null).map((state) => ({
    params: { state: state.id },
    props: { state },
  }));
}

const { state } = Astro.props;

/** Two lines, as vgpu sets its own — the break is part of the composition. */
const HEADLINE: Record<string, readonly [string, string]> = {
  drone: ["The autonomous aerial", "platform, coming soon."],
  quadruped: ["Legged robotics for", "terrain, coming soon."],
  manipulator: ["Precision industrial", "motion, coming soon."],
  robot: ["The humanoid for human", "spaces, coming soon."],
};

const BLURB: Record<string, string> = {
  drone: "Flight stack, perception and fleet control — talk to us about early access",
  quadruped: "Terrain wheels cannot cross — talk to us about early access",
  manipulator: "Repeatable industrial motion — talk to us about early access",
  robot: "Built for human-shaped environments — talk to us about early access",
};

const platforms = PRISM_STATES.filter((entry) => entry.id !== "orb");
const headline = HEADLINE[state.id]!;
---

<Base
  title={`${state.label} — OmniDynamics`}
  description={`${state.label} by OmniDynamics. Coming soon.`}
>
  <LightPrism frame="#prism-stage" />

  <div class="page">
    <header class="top">
      <a class="brand clicky" href="/">
        <Logo size={30} />
        <span class="wordmark">OmniDynamics</span>
      </a>
      <nav class="links">
        <a class="clicky" href="/">Prism</a>
        <a class="clicky" href="mailto:hello@omnidynamics.dev">Contact</a>
      </nav>
    </header>

    <main class="split">
      <div class="copy">
        {/* vgpu's wordmark is four characters wide; ours run to eleven, so the
            display size is capped by the name's own length as well as the
            viewport, and the longest one still clears the prism's column. */}
        <h1 style={`--chars:${state.label.length}`}>{state.label}</h1>
        <p class="lede">
          {headline[0]}<br />{headline[1]}
        </p>

        <p class="tabs">
          {platforms.map((entry, index) => (
            <>
              {index > 0 && <span class="dot" aria-hidden="true">·</span>}
              <a
                class:list={["tab", { on: entry.id === state.id }]}
                href={`/soon/${entry.id}/`}
                aria-current={entry.id === state.id ? "page" : undefined}
              >
                {entry.label}
              </a>
            </>
          ))}
        </p>

        <div class="rule" aria-hidden="true"></div>

        <p class="note">
          <a class="clicky" href="mailto:hello@omnidynamics.dev">{BLURB[state.id]}</a>
        </p>
      </div>

      {/* Measured, never painted: the box the prism is fitted into. */}
      <div class="stage" id="prism-stage" aria-hidden="true"></div>
    </main>
  </div>
</Base>

<style>
  /* The copy sits directly on the lit plaster, as vgpu's does — white type over
     the wall, with no panel or card between them. */
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 4vw, 3.5rem)
      clamp(1.5rem, 4vh, 3rem);
    color: var(--on-wall);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }

  .wordmark {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .links {
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    font-size: 0.9375rem;
  }
  .links a {
    color: inherit;
    text-decoration: none;
    opacity: 0.62;
    transition: opacity 0.2s ease;
  }
  .links a:hover { opacity: 1; }

  .split {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 3rem);
  }

  .copy {
    max-inline-size: 34rem;
    padding-inline-start: clamp(0rem, 2vw, 2rem);
  }

  /* vgpu sets its wordmark in a serif, several times the size of anything else
     on the page; the platform name takes that slot here. */
  h1 {
    margin: 0;
    font-family: ui-serif, Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(3.25rem, min(11vw, calc(78vw / var(--chars, 6))), 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: clamp(1rem, 3vh, 2rem) 0 0;
    font-size: clamp(1.5rem, 3.1vw, 2.6rem);
    line-height: 1.16;
    font-weight: 300;
    letter-spacing: -0.015em;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    margin: clamp(1.5rem, 4vh, 2.75rem) 0 0;
    font-size: 1.0625rem;
  }

  .tab {
    color: inherit;
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.2s ease;
  }
  .tab:hover { opacity: 0.85; }
  .tab.on { opacity: 1; }
  .dot { opacity: 0.35; }

  /* The hairline under vgpu's tab row, and the muted line beneath it. */
  .rule {
    inline-size: min(100%, 22rem);
    block-size: 1px;
    margin-block: clamp(1rem, 2.5vh, 1.5rem);
    background: currentColor;
    opacity: 0.28;
  }

  .note {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .note a {
    color: inherit;
    text-decoration: none;
    opacity: 0.72;
    transition: opacity 0.2s ease;
  }
  .note a:hover { opacity: 1; }

  /* Reserves the prism's share of the frame. Nothing is drawn in it — the
     renderer measures the box and fits the glass to it on the canvas behind. */
  .stage { min-block-size: 60vh; }

  /* One column: the copy holds the frame and the prism recentres behind it. */
  @media (max-width: 60rem) {
    .split {
      grid-template-columns: 1fr;
      align-content: center;
      gap: clamp(1.5rem, 5vh, 3rem);
    }
    .stage { min-block-size: 34vh; order: -1; }
    .copy { padding-inline-start: 0; }
  }
</style>
