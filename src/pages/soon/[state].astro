---
import Base from "../../layouts/Base.astro";
import Logo from "../../components/Logo.astro";
import Prism from "../../components/Prism.astro";
import { PRISM_STATES } from "../../lib/glass/models";

export function getStaticPaths() {
  return PRISM_STATES.filter((state) => state.href === null).map((state) => ({
    params: { state: state.id },
    props: { state },
  }));
}

const { state } = Astro.props;

const BLURB: Record<string, string> = {
  drone: "Autonomous aerial platform. Flight stack, perception and fleet control.",
  quadruped: "Legged platform for terrain that wheels cannot cross.",
  manipulator: "Precision arm for repeatable industrial motion.",
  robot: "General-purpose humanoid for human-shaped environments.",
};
---

<Base
  title={`${state.label} — OmniDynamics`}
  description={`${state.label} by OmniDynamics. Coming soon.`}
>
  <div class="page">
    <header class="top">
      <a class="brand clicky" href="/">
        <Logo />
        <span class="wordmark">OmniDynamics</span>
      </a>
      <a class="contact clicky" href="mailto:hello@omnidynamics.dev">Contact</a>
    </header>

    <main class="split">
      <div class="copy">
        <p class="eyebrow">{state.label}</p>
        <h1>Coming<br />soon</h1>
        <p class="blurb">{BLURB[state.id]}</p>
        <a class="back clicky" href="/">
          <span aria-hidden="true">←</span> Back to the prism
        </a>
      </div>

      <div class="art">
        <Prism initial={state.id} picker={false} />
      </div>
    </main>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 2;
    max-inline-size: 88rem;
    margin-inline: auto;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1rem, 4vw, 3rem) 0;
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: clamp(0.75rem, 2vh, 1.5rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }

  .wordmark {
    font-size: clamp(1rem, 1.35vw, 1.15rem);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .contact {
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--ink);
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(12px) saturate(170%);
    -webkit-backdrop-filter: blur(12px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.12),
      0 8px 20px -12px rgb(60 48 34 / 0.45);
  }

  /* Text left, prism right — the reference layout. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 3.5rem);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-size: clamp(3.25rem, 9vw, 7.5rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 600;
  }

  .blurb {
    margin: 1.25rem 0 0;
    max-inline-size: 26rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 2rem;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--ink);
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(12px) saturate(170%);
    -webkit-backdrop-filter: blur(12px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.12),
      0 8px 20px -12px rgb(60 48 34 / 0.45);
  }

  @media (max-width: 56rem) {
    .split {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .art { order: -1; }
  }
</style>
