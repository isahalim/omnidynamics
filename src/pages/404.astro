---
/**
 * Not found, on the same wall as everything else.
 *
 * No prism here: the renderer is the heaviest thing the site can ask for, and
 * a page reached by mistake is the one page not worth spending it on. The body
 * gradient behind it is the flat stand-in for the lit plaster, so the wall is
 * still the wall — just unlit.
 */
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { ROUTES } from "../lib/auth/config";
import { withBase } from "../lib/base";
---

<Base title="Not found — OmniDynamics" description="Page not found.">
  <div class="page">
    <header class="top">
      <a class="brand clicky" href={withBase("/")}>
        <Logo size={30} />
        <span class="wordmark">OmniDynamics</span>
      </a>
    </header>

    <main>
      <p class="stamp">404</p>
      <h1>Nothing here</h1>
      <p class="lede">
        That address does not exist on this site — it may have moved, or never
        have been.
      </p>

      <div class="rule" aria-hidden="true"></div>

      <p class="links">
        <a class="clicky" href={withBase("/")}>The platforms</a>
        <span class="dot" aria-hidden="true">·</span>
        <a class="clicky" href={ROUTES.book}>Book a demo</a>
        <span class="dot" aria-hidden="true">·</span>
        <a class="clicky" href={ROUTES.privacy}>Privacy</a>
      </p>
    </main>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    max-inline-size: 48rem;
    margin-inline: auto;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 4vw, 2.5rem)
      clamp(3rem, 8vh, 5rem);
    color: var(--on-wall);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }
  .wordmark { font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .stamp {
    margin: 0 0 0.65rem;
    font-size: 0.8125rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  h1 {
    margin: 0;
    font-family: ui-serif, Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(3rem, 9vw, 5.5rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: clamp(0.9rem, 2.5vh, 1.4rem) 0 0;
    max-inline-size: 30rem;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.3;
    font-weight: 300;
    letter-spacing: -0.015em;
  }

  .rule {
    inline-size: min(100%, 22rem);
    block-size: 1px;
    margin-block: clamp(1.5rem, 4vh, 2.5rem);
    background: currentColor;
    opacity: 0.28;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    font-size: 1.0625rem;
  }
  .links a {
    color: inherit;
    text-decoration: none;
    opacity: 0.68;
    transition: opacity 0.2s ease;
  }
  .links a:hover { opacity: 1; }
  .dot { opacity: 0.35; }
</style>
