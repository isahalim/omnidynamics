---
/**
 * Sign in, on the same wall everything else stands on.
 *
 * The composition is the one the rest of the site uses — copy in a measured
 * column on the left, the glass fitted into the box on the right — so the door
 * into the product is plainly the same building as the front of it.
 *
 * There is one control, and it is Google's own button, drawn by Google in a
 * frame this page cannot reach into. That is deliberate. Everything else here
 * is cut from the site's glass, but the one thing that asks a person to trust
 * who they are talking to should be the article the browser vouches for rather
 * than a convincing copy of it. No password is typed here, ever: this page
 * cannot check one and has nowhere to send one.
 */
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import LightPrism from "../components/LightPrism.astro";
import { EMAIL, PROVIDER_HOST, ROUTES, SIGN_IN_READY } from "../lib/auth/config";
import { withBase } from "../lib/base";
---

<Base
  title="Sign in — OmniDynamics"
  description="Sign in to OmniDynamics with your Google account."
>
  <LightPrism frame="#prism-stage" />

  <div class="page">
    <main class="split">
      <div class="column">
        <a class="brand clicky" href={withBase("/")}>
          <Logo size={30} />
          <span class="wordmark">OmniDynamics</span>
        </a>

        <h1>Welcome</h1>
        <p class="lede">Sign in to reach your systems and your fleet.</p>

        {SIGN_IN_READY ? (
          <>
            {/* Shown only once the session has been picked up, so nobody who is
                already signed in is asked to do it again. */}
            <div class="known" data-known hidden>
              <p class="known-line">
                Signed in as <strong data-known-name></strong>
              </p>
              <button type="button" class="primary clicky" data-continue>Continue</button>
              <button type="button" class="quiet clicky" data-switch>Use a different account</button>
            </div>

            {/* Google draws its button in here once its script arrives. Until
                then the box holds its own height, so nothing on the page moves
                when it lands. */}
            <div class="door" data-door>
              <div class="button" data-button></div>
              <p class="waiting" data-waiting>Loading the sign-in button…</p>
            </div>

            <p class="error" role="alert" data-error hidden></p>

            {/* Say what is actually happening, in one line, where the decision
                is being made — not only in a policy nobody opens. */}
            <p class="fine">
              You sign in at <span class="issuer">{PROVIDER_HOST}</span>, and
              Google tells us your name and email address — nothing else, and
              nothing we could use to reach into your account. Your password
              never touches this site. <a href={ROUTES.privacy}>What we keep</a>.
            </p>
          </>
        ) : (
          <div class="unwired">
            <p>
              Sign-in is not connected in this build. Set
              <code>PUBLIC_GOOGLE_CLIENT_ID</code> to an OAuth client id from
              the Google Cloud Console, with this origin listed under Authorized
              JavaScript origins, and this page becomes the door to it.
            </p>
            <p class="fine">
              In the meantime: <a href={ROUTES.book}>book a demo</a>, or write to
              {" "}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            </p>
          </div>
        )}
      </div>

      {/* Measured, never painted: the box the prism is fitted into. The cards
          sit at its foot the way the system picker sits at the foot of the
          landing page — over the glass, on the same wall. */}
      <div class="stage" id="prism-stage">
        <div class="cards">
          <p class="eyebrow">Inside</p>
          <a class="card clicky" href="https://mythosengine.omnidynamics.dev/">
            <span class="kicker">Shipping</span>
            <span class="title">Mythos Engine</span>
            <span class="sub">Scripts, scenes and voice, from a prompt to a finished piece.</span>
          </a>
          <a class="card clicky" href="https://isahalim.github.io/Embodied-XAI-Is-All-You-Need/">
            <span class="kicker">Early access</span>
            <span class="title">ChronoVoxel</span>
            <span class="sub">Why a vision-language model chose what it chose, painted on the world itself.</span>
          </a>
        </div>
      </div>
    </main>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 4vw, 3.5rem)
      clamp(1.5rem, 4vh, 3rem);
    color: var(--on-wall);
  }

  .split {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 3.5rem);
  }

  .column {
    inline-size: min(100%, 27rem);
    justify-self: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }
  .wordmark {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  h1 {
    margin: clamp(1.75rem, 5vh, 3rem) 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 4.75rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0.85rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    opacity: 0.68;
  }

  /* The one control, and it is Google's. The frame is ours: a pane of the same
     glass everything else is cut from, with Google's button set into it, so a
     borrowed widget still sits inside the site rather than on top of it. The
     height is reserved up front — Google's script arrives late, and nothing
     below it should jump when it does. */
  .door {
    display: grid;
    place-items: center;
    min-block-size: 3.25rem;
    margin-block-start: clamp(1.5rem, 4vh, 2.25rem);
    padding: 0.35rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.1),
      0 12px 28px -16px rgb(60 48 34 / 0.45);
  }
  /* Both children occupy the same cell, so the message underneath is replaced
     by the button rather than pushed out of the way by it. */
  .door > * { grid-area: 1 / 1; }
  .waiting {
    margin: 0;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .primary,
  .quiet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    inline-size: 100%;
    padding: 0.85rem 1.2rem;
    border: 0;
    border-radius: 0.95rem;
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .primary {
    margin-block-start: 0.35rem;
    color: var(--wall);
    background: var(--ink);
    box-shadow: 0 1px 2px rgb(60 48 34 / 0.2), 0 10px 22px -12px rgb(20 18 15 / 0.8);
  }
  .primary:hover { background: #241f19; }
  .primary[disabled] { opacity: 0.55; cursor: progress; }

  .quiet {
    margin-block-start: 0.15rem;
    color: var(--muted);
    background: transparent;
    font-size: 0.875rem;
  }
  .quiet:hover { color: var(--ink); }

  .known {
    display: grid;
    gap: 0.4rem;
    margin-block-start: clamp(1.5rem, 4vh, 2.25rem);
  }
  .known-line { margin: 0 0 0.35rem; font-size: 0.9375rem; opacity: 0.75; }
  .known-line strong { font-weight: 600; opacity: 1; }

  .error {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    color: var(--accent);
  }

  .fine {
    margin: clamp(1.25rem, 3vh, 1.75rem) 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .fine a { color: inherit; text-underline-offset: 0.2em; }
  .issuer { color: var(--ink); }

  .unwired {
    margin-block-start: clamp(1.5rem, 4vh, 2.25rem);
    padding: 1.15rem 1.25rem;
    border-radius: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    background: rgb(255 255 255 / 0.45);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.85);
  }
  .unwired p { margin: 0; }
  .unwired code {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 0.35em;
    background: rgb(60 48 34 / 0.08);
  }

  /* A finger aims the beam by dragging where the prism is drawn, so that box
     must not read the drag as a scroll. */
  .stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-block-size: 72vh;
    touch-action: pinch-zoom;
  }

  .cards {
    inline-size: 100%;
    display: grid;
    gap: 0.6rem;
    padding-inline: clamp(0rem, 2vw, 1.5rem);
  }

  .eyebrow {
    margin: 0 0 0.15rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card {
    display: grid;
    gap: 0.15rem;
    padding: 0.95rem 1.15rem;
    border-radius: 1.1rem;
    text-decoration: none;
    color: var(--ink);
    background: rgb(255 255 255 / 0.42);
    backdrop-filter: blur(16px) saturate(170%);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      0 1px 2px rgb(60 48 34 / 0.08),
      0 16px 34px -22px rgb(60 48 34 / 0.55);
  }
  .card:hover { background: rgb(255 255 255 / 0.58); }
  .kicker {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .sub { font-size: 0.875rem; line-height: 1.45; color: var(--muted); }

  @media (max-width: 60rem) {
    .split {
      grid-template-columns: 1fr;
      align-content: center;
      gap: clamp(1.5rem, 5vh, 2.5rem);
    }
    .column { justify-self: start; }
    .stage { min-block-size: 34vh; order: -1; }
    .cards { display: none; }
  }
</style>

<script>
  import { SIGN_IN_READY } from "../lib/auth/config";
  import { mountSignIn, observe, offerOneTap, restore, signOut } from "../lib/auth/session";

  if (SIGN_IN_READY) {
    const door = document.querySelector<HTMLElement>("[data-door]");
    const button = document.querySelector<HTMLElement>("[data-button]");
    const waiting = document.querySelector<HTMLElement>("[data-waiting]");
    const known = document.querySelector<HTMLElement>("[data-known]");
    const knownName = document.querySelector<HTMLElement>("[data-known-name]");
    const error = document.querySelector<HTMLElement>("[data-error]");
    if (!door || !button || !waiting || !known || !knownName || !error) {
      throw new Error("sign-in markup missing");
    }

    /**
     * Where to land afterwards. It arrives in the query string, so it is
     * whatever the last page put there — or whatever anyone else did. A path on
     * this site, or nothing: an off-site "next" never becomes a destination.
     */
    const asked = new URLSearchParams(window.location.search).get("next");
    const next =
      asked && asked.startsWith("/") && !asked.startsWith("//") ? asked : import.meta.env.BASE_URL;

    const say = (message: string) => {
      error.textContent = message;
      error.hidden = message === "";
    };

    // Google sizes its button in pixels and will not take a percentage, so the
    // column's own width is measured and handed over, clamped to the range the
    // library accepts.
    const width = Math.round(
      Math.min(400, Math.max(200, door.getBoundingClientRect().width - 12))
    );

    mountSignIn(button, { width })
      .then(() => { waiting.hidden = true; })
      .catch((cause: unknown) => {
        // The script never arrived — an extension blocking it, a network that
        // will not reach Google. This page is still here and has to say so
        // rather than leave a reader pressing an empty box.
        console.error("sign-in button failed to load", cause);
        waiting.hidden = true;
        say("We could not load the Google sign-in button. Check your connection or any blocker, then reload.");
      });

    // Signing in happens inside Google's frame, so there is no click to handle
    // here — the session simply arrives. When it does, go where they were going.
    let settled = false;
    observe((who) => {
      known.hidden = who === null;
      door.hidden = who !== null;
      knownName.textContent = who?.name ?? "";
      if (who && settled) window.location.href = next;
      if (who) settled = true;
    });

    void restore().then(() => {
      settled = true;
      // Nobody in this tab, but Google may still know them from another one:
      // One Tap is the one-click way back, offered here and nowhere else.
      void offerOneTap();
    });

    document.querySelector("[data-continue]")?.addEventListener("click", () => {
      window.location.href = next;
    });
    document.querySelector("[data-switch]")?.addEventListener("click", () => {
      // Ends it here and stops Google resuming it automatically, which puts the
      // account chooser back in front of them.
      void signOut();
    });
  }
</script>
