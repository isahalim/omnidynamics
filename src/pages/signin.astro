---
/**
 * Sign in, on the same wall everything else stands on.
 *
 * The composition is the one the rest of the site uses — copy in a measured
 * column on the left, the glass fitted into the box on the right — so the door
 * into the product is plainly the same building as the front of it. What is
 * different is that the left column is a form, and the form collects exactly
 * one thing: an address to hand the provider as a hint. No password is typed
 * here, ever. This page cannot check one, has nowhere to send one, and the
 * moment a button is pressed the browser leaves for the provider.
 */
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import LightPrism from "../components/LightPrism.astro";
import { EMAIL, IDP, ISSUER_HOST, OIDC_READY, ROUTES } from "../lib/auth/config";
import { withBase } from "../lib/base";

const federated = {
  google: Boolean(IDP.google),
  sso: Boolean(IDP.sso),
};
const anyFederated = federated.google || federated.sso;
---

<Base
  title="Sign in — OmniDynamics"
  description="Sign in to OmniDynamics with OpenID Connect."
>
  <LightPrism frame="#prism-stage" />

  <div class="page">
    <main class="split">
      <div class="column">
        <a class="brand clicky" href={withBase("/")}>
          <Logo size={30} />
          <span class="wordmark">OmniDynamics</span>
        </a>

        <h1>Welcome</h1>
        <p class="lede">Sign in to reach your platforms and your fleet.</p>

        {OIDC_READY ? (
          <>
            {/* Shown only once the session has been picked up, so nobody who is
                already signed in is asked to do it again. */}
            <div class="known" data-known hidden>
              <p class="known-line">
                Signed in as <strong data-known-name></strong>
              </p>
              <button type="button" class="primary clicky" data-continue>Continue</button>
              <button type="button" class="quiet clicky" data-switch>Use a different account</button>
            </div>

            <form class="form" data-form>
              <label class="label" for="email">Work email</label>
              <input
                class="field"
                id="email"
                name="email"
                type="email"
                autocomplete="username"
                inputmode="email"
                spellcheck="false"
                placeholder="you@company.com"
                required
              />
              {/* The provider decides what to do with the address — a one-time
                  link, a passkey, a directory it recognises the domain of. That
                  is the point of federating: this page does not get a vote. */}
              <button type="submit" class="primary clicky" data-submit>Continue with email</button>
            </form>

            {anyFederated && (
              <>
                <p class="divider"><span>Or continue with</span></p>
                <div class="federated">
                  {federated.google && (
                    <button type="button" class="secondary clicky" data-idp="google">
                      <svg class="glyph" viewBox="0 0 18 18" aria-hidden="true">
                        <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"/>
                        <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.95v2.33A9 9 0 0 0 9 18Z"/>
                        <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.95a9 9 0 0 0 0 8.1l3.02-2.33Z"/>
                        <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.89 11.43 0 9 0A9 9 0 0 0 .95 4.95l3.02 2.33C4.68 5.16 6.66 3.58 9 3.58Z"/>
                      </svg>
                      Google
                    </button>
                  )}
                  {federated.sso && (
                    <button type="button" class="secondary clicky" data-idp="sso">
                      <svg class="glyph" viewBox="0 0 18 18" aria-hidden="true" fill="none"
                        stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                        <rect x="3.5" y="7.75" width="11" height="7.25" rx="1.6" />
                        <path d="M6.1 7.75V5.4a2.9 2.9 0 0 1 5.8 0v2.35" />
                      </svg>
                      Enterprise SSO
                    </button>
                  )}
                </div>
              </>
            )}

            <p class="error" role="alert" data-error hidden></p>

            {/* Say what is actually happening, in one line, where the decision
                is being made — not only in a policy nobody opens. */}
            <p class="fine">
              OmniDynamics uses OpenID Connect. You sign in at
              {" "}<span class="issuer">{ISSUER_HOST}</span>, which tells us
              your name and email address and nothing else. Your password never
              reaches this site. <a href={ROUTES.privacy}>What we keep</a>.
            </p>
          </>
        ) : (
          <div class="unwired">
            <p>
              Sign-in is not connected in this build. Set
              <code>PUBLIC_OIDC_ISSUER</code> and <code>PUBLIC_OIDC_CLIENT_ID</code>
              to any OpenID Connect provider — Zitadel, Keycloak, Authentik and
              Ory Hydra are all free and open source — and this page becomes the
              door to it.
            </p>
            <p class="fine">
              In the meantime: <a href={ROUTES.book}>book a demo</a>, or write to
              {" "}<a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
            </p>
          </div>
        )}
      </div>

      {/* Measured, never painted: the box the prism is fitted into. The cards
          sit at its foot the way the platform picker sits at the foot of the
          landing page — over the glass, on the same wall. */}
      <div class="stage" id="prism-stage">
        <div class="cards">
          <p class="eyebrow">Inside</p>
          <a class="card clicky" href="https://mythosengine.omnidynamics.dev/">
            <span class="kicker">Shipping</span>
            <span class="title">Mythos Engine</span>
            <span class="sub">Scripts, scenes and voice, from a prompt to a finished piece.</span>
          </a>
          <a class="card clicky" href={withBase("/soon/drone/")}>
            <span class="kicker">Early access</span>
            <span class="title">Drone, manipulator, humanoid</span>
            <span class="sub">Flight stack, industrial motion, and a body for human spaces.</span>
          </a>
        </div>
      </div>
    </main>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 4vw, 3.5rem)
      clamp(1.5rem, 4vh, 3rem);
    color: var(--on-wall);
  }

  .split {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: clamp(1rem, 4vw, 3.5rem);
  }

  .column {
    inline-size: min(100%, 27rem);
    justify-self: center;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }
  .wordmark {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  h1 {
    margin: clamp(1.75rem, 5vh, 3rem) 0 0;
    font-family: ui-serif, Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(3rem, 7vw, 4.75rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0.85rem 0 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    opacity: 0.68;
  }

  .form {
    display: grid;
    gap: 0.5rem;
    margin-block-start: clamp(1.5rem, 4vh, 2.25rem);
  }

  .label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    opacity: 0.72;
  }

  /* The one input on the site, so it is cut from the same glass as everything
     else: frosted, lifted off the plaster, no hard border. */
  .field {
    inline-size: 100%;
    padding: 0.85rem 1.1rem;
    border: 0;
    border-radius: 0.95rem;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: rgb(255 255 255 / 0.55);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.1),
      0 10px 24px -18px rgb(60 48 34 / 0.5);
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .field::placeholder { color: var(--muted); opacity: 0.7; }
  .field:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
    background: rgb(255 255 255 / 0.72);
  }

  .primary,
  .secondary,
  .quiet {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    inline-size: 100%;
    padding: 0.85rem 1.2rem;
    border: 0;
    border-radius: 0.95rem;
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .primary {
    margin-block-start: 0.35rem;
    color: var(--wall);
    background: var(--ink);
    box-shadow: 0 1px 2px rgb(60 48 34 / 0.2), 0 10px 22px -12px rgb(20 18 15 / 0.8);
  }
  .primary:hover { background: #241f19; }
  .primary[disabled] { opacity: 0.55; cursor: progress; }

  .secondary {
    color: var(--ink);
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      0 1px 2px rgb(60 48 34 / 0.1),
      0 10px 24px -18px rgb(60 48 34 / 0.5);
  }
  .secondary:hover { background: rgb(255 255 255 / 0.7); }
  .secondary[disabled] { opacity: 0.55; cursor: progress; }

  .quiet {
    margin-block-start: 0.15rem;
    color: var(--muted);
    background: transparent;
    font-size: 0.875rem;
  }
  .quiet:hover { color: var(--ink); }

  .glyph { inline-size: 1.125rem; block-size: 1.125rem; flex: none; }

  .divider {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: clamp(1.1rem, 3vh, 1.6rem) 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    block-size: 1px;
    background: currentColor;
    opacity: 0.3;
  }

  .federated { display: grid; gap: 0.55rem; }

  .known {
    display: grid;
    gap: 0.4rem;
    margin-block-start: clamp(1.5rem, 4vh, 2.25rem);
  }
  .known-line { margin: 0 0 0.35rem; font-size: 0.9375rem; opacity: 0.75; }
  .known-line strong { font-weight: 600; opacity: 1; }

  .error {
    margin: 0.9rem 0 0;
    font-size: 0.875rem;
    color: var(--accent);
  }

  .fine {
    margin: clamp(1.25rem, 3vh, 1.75rem) 0 0;
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .fine a { color: inherit; text-underline-offset: 0.2em; }
  .issuer { color: var(--ink); }

  .unwired {
    margin-block-start: clamp(1.5rem, 4vh, 2.25rem);
    padding: 1.15rem 1.25rem;
    border-radius: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    background: rgb(255 255 255 / 0.45);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.85);
  }
  .unwired p { margin: 0; }
  .unwired code {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 0.35em;
    background: rgb(60 48 34 / 0.08);
  }

  /* A finger aims the beam by dragging where the prism is drawn, so that box
     must not read the drag as a scroll. */
  .stage {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-block-size: 72vh;
    touch-action: pinch-zoom;
  }

  .cards {
    inline-size: 100%;
    display: grid;
    gap: 0.6rem;
    padding-inline: clamp(0rem, 2vw, 1.5rem);
  }

  .eyebrow {
    margin: 0 0 0.15rem;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card {
    display: grid;
    gap: 0.15rem;
    padding: 0.95rem 1.15rem;
    border-radius: 1.1rem;
    text-decoration: none;
    color: var(--ink);
    background: rgb(255 255 255 / 0.42);
    backdrop-filter: blur(16px) saturate(170%);
    -webkit-backdrop-filter: blur(16px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      0 1px 2px rgb(60 48 34 / 0.08),
      0 16px 34px -22px rgb(60 48 34 / 0.55);
  }
  .card:hover { background: rgb(255 255 255 / 0.58); }
  .kicker {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .title { font-size: 1rem; font-weight: 600; letter-spacing: -0.01em; }
  .sub { font-size: 0.875rem; line-height: 1.45; color: var(--muted); }

  @media (max-width: 60rem) {
    .split {
      grid-template-columns: 1fr;
      align-content: center;
      gap: clamp(1.5rem, 5vh, 2.5rem);
    }
    .column { justify-self: start; }
    .stage { min-block-size: 34vh; order: -1; }
    .cards { display: none; }
  }
</style>

<script>
  import { OIDC_READY } from "../lib/auth/config";
  import { observe, restore, signIn } from "../lib/auth/session";

  if (OIDC_READY) {
    const form = document.querySelector<HTMLFormElement>("[data-form]");
    const email = document.querySelector<HTMLInputElement>("#email");
    const known = document.querySelector<HTMLElement>("[data-known]");
    const knownName = document.querySelector<HTMLElement>("[data-known-name]");
    const error = document.querySelector<HTMLElement>("[data-error]");
    if (!form || !email || !known || !knownName || !error) {
      throw new Error("sign-in markup missing");
    }

    /**
     * Where to land afterwards. It arrives in the query string, so it is
     * whatever the last page put there — or whatever anyone else did. It is
     * carried through the redirect and checked again on the way back, in
     * `safeReturn`; an off-site "next" never becomes a destination.
     */
    const next = new URLSearchParams(window.location.search).get("next") ?? undefined;

    const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-submit],[data-idp]")];
    const say = (message: string) => {
      error.textContent = message;
      error.hidden = message === "";
    };

    const leave = async (options: Parameters<typeof signIn>[0]) => {
      say("");
      for (const button of buttons) button.disabled = true;
      try {
        await signIn({ ...options, returnTo: next });
      } catch (cause) {
        // The redirect never started — the provider's discovery document is
        // unreachable, or the client is misregistered. Either way this page is
        // still here and has to say so.
        console.error("sign-in failed", cause);
        say("We could not reach the sign-in service. Try again in a moment.");
        for (const button of buttons) button.disabled = false;
      }
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      void leave({ email: email.value.trim() });
    });

    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-idp]")) {
      button.addEventListener("click", () => {
        const via = button.dataset.idp as "google" | "sso";
        // A typed address still helps an enterprise directory find its realm.
        void leave({ via, email: email.value.trim() || undefined });
      });
    }

    // Already signed in: offer the way onward rather than a second sign-in.
    observe((who) => {
      known.hidden = who === null;
      form.hidden = who !== null;
      knownName.textContent = who?.name ?? "";
      for (const element of document.querySelectorAll<HTMLElement>(".divider, .federated")) {
        element.hidden = who !== null;
      }
    });
    void restore();

    document.querySelector("[data-continue]")?.addEventListener("click", () => {
      window.location.href = next && next.startsWith("/") && !next.startsWith("//")
        ? next
        : import.meta.env.BASE_URL;
    });
    document.querySelector("[data-switch]")?.addEventListener("click", () => {
      // Ask the provider to prompt, rather than silently reusing its cookie.
      void leave({ prompt: "select_account" });
    });
  }
</script>
