---
/**
 * Everything this site knows about the person reading it, on one page.
 *
 * Not a settings screen — there is nothing here to configure, because the
 * account lives at the provider and this site holds no copy of it. What it is
 * for is disclosure: the claims that arrived in the id token, the scopes the
 * provider actually granted, what is cached in this browser and for how long,
 * and two buttons that end it. A privacy policy that says "we hold your name
 * and email" is a promise; a page that shows exactly what is held is a fact.
 */
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { EMAIL, ISSUER_HOST, OIDC_READY, ROUTES } from "../lib/auth/config";
import { withBase } from "../lib/base";
---

<Base title="Your account — OmniDynamics" description="What OmniDynamics knows about your account.">
  <div class="page">
    <header class="top">
      <a class="brand clicky" href={withBase("/")}>
        <Logo size={30} />
        <span class="wordmark">OmniDynamics</span>
      </a>
      <nav class="links">
        <a class="clicky" href={ROUTES.privacy}>Privacy</a>
        <a class="clicky" href={ROUTES.book}>Book a demo</a>
      </nav>
    </header>

    <main>
      {OIDC_READY ? (
        <>
          <p class="waiting" data-waiting>Checking your session…</p>

          <section class="out" data-out hidden>
            <h1>Not signed in</h1>
            <p class="lede">
              There is no session in this browser, so there is nothing here to
              show you.
            </p>
            <p class="links"><a class="clicky" href={ROUTES.signIn}>Sign in</a></p>
          </section>

          <section class="in" data-in hidden>
            <h1 data-name></h1>
            <p class="lede" data-email></p>

            <div class="rule" aria-hidden="true"></div>

            <h2>What we were told about you</h2>
            <p class="note">
              These claims came from <span class="host">{ISSUER_HOST}</span> in a
              signed identity token when you signed in. We asked for your name
              and email address; a provider may send a little more, and anything
              it sent is listed here.
            </p>
            <dl class="claims" data-claims></dl>

            <h2>What this browser is holding</h2>
            <ul class="facts">
              <li>
                <strong>Access and identity tokens</strong> — in memory only, for
                this tab. Closing it discards them; nothing is written to
                <code>localStorage</code>, where a token would outlive the visit.
              </li>
              <li>
                <strong>Session</strong> — held as a cookie by
                <span class="host">{ISSUER_HOST}</span>, not by this site. Your
                token is renewed against it in the background and expires in
                <span data-expires>—</span>.
              </li>
              <li>
                <strong>Cached page state</strong> — filed under your account and
                erased when you sign out, or the moment a different account signs
                in on this browser. <span data-cached>Nothing is cached.</span>
              </li>
              <li>
                <strong>No cookies of our own, and no analytics.</strong> This
                site sets nothing and measures nobody.
              </li>
            </ul>

            <h2>Ending it</h2>
            <p class="note">
              Signing out clears this browser first, then asks
              <span class="host">{ISSUER_HOST}</span> to end the session and
              revoke the tokens. To delete the account itself — the copy that
              matters — use your provider, or write to
              {" "}<a href={`mailto:${EMAIL}`}>{EMAIL}</a> and we will confirm
              what was removed.
            </p>
            <div class="buttons">
              <button type="button" class="primary clicky" data-signout>Sign out</button>
              <button type="button" class="secondary clicky" data-forget>Clear cached page state</button>
            </div>
            <p class="said" role="status" data-said></p>
          </section>
        </>
      ) : (
        <section class="out">
          <h1>Accounts are not connected</h1>
          <p class="lede">
            This build has no identity provider configured, so there is no
            account to show.
          </p>
          <p class="links"><a class="clicky" href={ROUTES.book}>Book a demo</a></p>
        </section>
      )}
    </main>
  </div>
</Base>

<style>
  .page {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-block-size: 100dvh;
    max-inline-size: 52rem;
    margin-inline: auto;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 4vw, 2.5rem)
      clamp(3rem, 8vh, 5rem);
    color: var(--on-wall);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: clamp(2rem, 6vh, 3.5rem);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }
  .wordmark { font-size: 1rem; font-weight: 500; letter-spacing: -0.01em; }
  .links { display: flex; gap: clamp(1rem, 2.5vw, 2rem); font-size: 0.9375rem; }
  .links a { color: inherit; text-decoration: none; opacity: 0.62; transition: opacity 0.2s ease; }
  .links a:hover { opacity: 1; }

  .waiting { margin: 0; color: var(--muted); }

  h1 {
    margin: 0;
    font-family: ui-serif, Georgia, "Iowan Old Style", "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  h2 {
    margin: clamp(2rem, 5vh, 2.75rem) 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .lede {
    margin: 0.75rem 0 0;
    font-size: 1.125rem;
    line-height: 1.5;
    opacity: 0.7;
    overflow-wrap: anywhere;
  }

  .rule {
    inline-size: min(100%, 22rem);
    block-size: 1px;
    margin-block: clamp(1.5rem, 4vh, 2.25rem);
    background: currentColor;
    opacity: 0.28;
  }

  .note { margin: 0; font-size: 0.9375rem; line-height: 1.6; color: var(--muted); }
  .note a, .facts a { color: inherit; }
  .host { color: var(--ink); }

  .claims {
    display: grid;
    grid-template-columns: minmax(7rem, 12rem) minmax(0, 1fr);
    gap: 0.15rem 1.25rem;
    margin: 1rem 0 0;
    padding: 1.1rem 1.25rem;
    border-radius: 1.1rem;
    font-size: 0.9375rem;
    background: rgb(255 255 255 / 0.45);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.85),
      0 16px 34px -24px rgb(60 48 34 / 0.55);
  }
  .claims dt { color: var(--muted); font-variant-numeric: tabular-nums; }
  .claims dd { margin: 0; overflow-wrap: anywhere; }

  .facts {
    margin: 0.9rem 0 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .facts strong { color: var(--ink); font-weight: 600; }
  code {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    border-radius: 0.35em;
    background: rgb(60 48 34 / 0.08);
  }

  .buttons { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-block-start: 1.1rem; }

  .primary, .secondary {
    padding: 0.75rem 1.35rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
  }
  .primary {
    color: var(--wall);
    background: var(--ink);
    box-shadow: 0 1px 2px rgb(60 48 34 / 0.2), 0 8px 18px -10px rgb(20 18 15 / 0.8);
  }
  .primary:hover { background: #241f19; }
  .secondary {
    color: var(--ink);
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(14px) saturate(170%);
    -webkit-backdrop-filter: blur(14px) saturate(170%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.9), 0 1px 2px rgb(60 48 34 / 0.1);
  }
  .secondary:hover { background: rgb(255 255 255 / 0.7); }

  .said { margin: 0.75rem 0 0; min-block-size: 1.2em; font-size: 0.875rem; color: var(--muted); }
</style>

<script>
  import { OIDC_READY } from "../lib/auth/config";
  import { current, observe, restore, scopedStorage, signOut, type Account } from "../lib/auth/session";

  if (OIDC_READY) {
    const waiting = document.querySelector<HTMLElement>("[data-waiting]");
    const out = document.querySelector<HTMLElement>("[data-out]");
    const inside = document.querySelector<HTMLElement>("[data-in]");
    const claims = document.querySelector<HTMLElement>("[data-claims]");
    if (!waiting || !out || !inside || !claims) throw new Error("account markup missing");

    const set = (selector: string, text: string) => {
      const node = document.querySelector<HTMLElement>(selector);
      if (node) node.textContent = text;
    };

    /** Seconds as something a person reads without counting zeros. */
    const lasting = (seconds: number) => {
      if (seconds <= 0) return "less than a minute";
      const minutes = Math.round(seconds / 60);
      if (minutes < 60) return `${minutes} minute${minutes === 1 ? "" : "s"}`;
      const hours = Math.round(minutes / 60);
      return `${hours} hour${hours === 1 ? "" : "s"}`;
    };

    /** A claim value as text — objects and arrays included, unabridged. */
    const asText = (value: unknown) =>
      typeof value === "string" ? value : JSON.stringify(value);

    const show = (who: Account | null) => {
      waiting.hidden = true;
      out.hidden = who !== null;
      inside.hidden = who === null;
      if (!who) return;

      set("[data-name]", who.name || who.email || "Your account");
      set(
        "[data-email]",
        who.email
          ? `${who.email}${who.emailVerified ? " · verified by your provider" : " · not verified"}`
          : "No email address was shared."
      );
      set("[data-expires]", lasting(who.expiresIn));

      // Every claim held, sorted, with the scopes granted beside them — which
      // may be fewer than were asked for, and that is worth being able to see.
      const rows: [string, string][] = Object.entries(who.claims)
        .map(([key, value]) => [key, asText(value)] as [string, string])
        .sort(([a], [b]) => a.localeCompare(b));
      rows.push(["scopes granted", who.scopes.join(", ")]);
      claims.replaceChildren(
        ...rows.flatMap(([key, value]) => {
          const dt = document.createElement("dt");
          dt.textContent = key;
          const dd = document.createElement("dd");
          dd.textContent = value;
          return [dt, dd];
        })
      );

      const cached = scopedStorage();
      const held = cached ? Object.keys(sessionStorage).filter((k) => k.startsWith("od.acct.")).length : 0;
      set("[data-cached]", held === 0 ? "Nothing is cached." : `${held} cached item${held === 1 ? "" : "s"}.`);
    };

    // `observe` answers immediately with what is known now, which on a cold
    // load is "nobody" — and this page must not say "not signed in" to someone
    // who is, for the second it takes to ask the provider. Nothing is shown
    // until there is an answer worth showing.
    let settled = false;
    observe((who) => {
      if (!settled && who === null) return;
      settled = true;
      show(who);
    });
    void restore().then(() => {
      settled = true;
      show(current());
    });

    document.querySelector("[data-signout]")?.addEventListener("click", () => {
      void signOut();
    });

    document.querySelector("[data-forget]")?.addEventListener("click", () => {
      scopedStorage()?.clear();
      set("[data-cached]", "Nothing is cached.");
      set("[data-said]", "Cached page state cleared.");
    });
  }
</script>
