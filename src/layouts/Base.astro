---
import { ICON_VERSION } from "../pages/site.webmanifest";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "OmniDynamics" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
/**
 * The site is served from the root of its own domain and mirrored onto GitHub
 * Pages under the repository's name, so nothing here may be written as a bare
 * absolute path. See `src/lib/base.ts`.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
/**
 * The card a shared link unfolds into, as an absolute URL: a scraper is not on
 * the page and has no origin to resolve a relative address against, so a
 * root-relative `/og.jpg` is the one asset here that has to carry the host too.
 *
 * `?v=` for the same reason the icons carry it, and with more teeth: LinkedIn,
 * Slack and the rest file a card by its image URL and hold it for weeks, so a
 * new picture at the old address is a picture nobody sees. Bump it when the
 * landing page changes enough that the card is wrong. See `scripts/build-og.mjs`.
 */
const OG_IMAGE_VERSION = "2";
const ogImage = new URL(`${base}/og.jpg?v=${OG_IMAGE_VERSION}`, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/*
      What a shared link unfolds into. The title, description and URL were here
      already and were not enough: LinkedIn will not draw a card at all without
      a picture to draw it around — it answers "We couldn't generate a preview
      for this link", which reads like the page failed to load rather than like
      a missing tag — and Slack, iMessage and X all fall back to a bare link for
      the same reason. The dimensions go alongside so the scraper can lay the
      card out before the image has finished arriving, and `og:image:alt` is
      what a screen reader gets in the feed, where the page's own markup is not.
    */}
    <meta property="og:site_name" content="OmniDynamics" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="The OmniDynamics landing page: “We deploy scalable agentic systems and platforms for evaluating Physical AI Agents”, set over a glass tetrahedron on a lit plaster wall."
    />
    {/*
      X reads the Open Graph tags for everything but the shape of the card, and
      defaults to the small square one. This is the only tag that asks for the
      wide image the picture above is cut for.
    */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#d2ccc2" />
    {/*
      The mark, everywhere something asks for one: the ink mark on nothing, in
      every size. Nothing here is adaptive — Safari does not resolve
      `prefers-color-scheme` inside a favicon — and nothing carries a ground.
      The ink is what does the work: these were white on nothing, which is a
      white disc anywhere the drawer picks a light plate, and Google composites
      a result row's icon onto exactly that. Without `apple-touch-icon` iOS
      draws its own — a grey square with the first letter of the title — which
      is what "Add to Home Screen" was producing.

      Each address carries `?v=`: Safari files favicons by URL and will not go
      back for a new one at an address it already has, so a mark that changes
      under a fixed name is a mark Safari goes on drawing the old version of.
    */}
    <link rel="icon" href={`${base}/favicon.svg?v=${ICON_VERSION}`} type="image/svg+xml" />
    <link
      rel="icon"
      href={`${base}/favicon-96.png?v=${ICON_VERSION}`}
      type="image/png"
      sizes="96x96"
    />
    <link
      rel="apple-touch-icon"
      href={`${base}/apple-touch-icon.png?v=${ICON_VERSION}`}
      sizes="180x180"
    />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <meta name="apple-mobile-web-app-title" content="OmniDynamics" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="default"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* vgpu's light-pipeline wall, read off vgpu.sh/?debug. The prism canvas
       shades this same colour on the GPU; the token is what stands in before
       the canvas is up, and what the UI chrome tints against. */
    --wall: #d2ccc2;
    --wall-deep: #c9c2b7;
    /* Copy sits directly on the lit plaster, the way vgpu's light mode does:
       near-black, with opacity doing the hierarchy rather than a second colour. */
    --on-wall: #0a0a0a;
    --ink: #16130f;
    --muted: #6d6459;
    --accent: #c0281d;
    --line: rgb(60 48 34 / 0.12);
  }

  *, *::before, *::after { box-sizing: border-box; }

  /* Components set display on these; without this the attribute is ignored. */
  [hidden] { display: none !important; }

  html { -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    min-block-size: 100dvh;
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Helvetica,
      Arial, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    /* The lit plaster and its tooth are shaded by the prism canvas, which
       covers the whole viewport. This gradient is only ever seen where that
       canvas is not: the 404, the moment before it fades up, and browsers
       without WebGPU. It cannot show as a seam the way the old CSS wall did,
       because the canvas either covers it completely or not at all — so it
       approximates the shader's window pool rather than sitting flat. */
    background:
      radial-gradient(120% 90% at 78% -12%, #d8d3c9 0%, transparent 62%),
      linear-gradient(168deg, var(--wall) 0%, var(--wall-deep) 100%);
    background-attachment: fixed;
  }

  img, svg { display: block; max-inline-size: 100%; }

  /* Every interactive surface lifts and casts, per the house style. */
  .clicky {
    transition: transform 0.14s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.22s ease, filter 0.22s ease;
  }
  .clicky:hover { transform: translateY(-1.5px); }
  .clicky:active { transform: translateY(0.5px) scale(0.985); }
  .clicky:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  @media (prefers-reduced-motion: reduce) {
    .clicky, .clicky:hover, .clicky:active { transition: none; transform: none; }
  }
</style>
