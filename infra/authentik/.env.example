# Copy to `.env` (gitignored) and fill in. `compose.yaml` refuses to start
# without the three marked required, which is the point: an authentik with a
# guessable secret key is not self-hosted, it is self-owned.

# ── Required ─────────────────────────────────────────────────────────────────
# Signs sessions and encrypts stored secrets. Generate once, never rotate
# casually — rotating it invalidates every session and every encrypted field.
#   openssl rand -base64 48
AUTHENTIK_SECRET_KEY=

# The Postgres password. Generate the same way.
PG_PASS=

# The site's public OAuth client id, as it appears in the site's own
# PUBLIC_OIDC_CLIENT_ID. Not a secret — a public client has none — but the two
# have to agree. Generate a fresh one for a new deployment:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 40
OMNIDYNAMICS_CLIENT_ID=

# ── Google sign-in ───────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID,
# application type "Web application". Free; no Workspace or paid tier needed.
#
# Register exactly this as an Authorized redirect URI, for each origin authentik
# is reached on:
#   http://localhost:9000/source/oauth/callback/google/
#
# These two are the only real secrets in the system. The client secret is held
# here, on the server, and never reaches a browser — which is the whole reason
# Google is federated behind authentik rather than talked to by the site.
# Leave both blank and the source is created but disabled, and the site renders
# no Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional ─────────────────────────────────────────────────────────────────
AUTHENTIK_ERROR_REPORTING__ENABLED=false
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
# AUTHENTIK_TAG=2026.8.2
